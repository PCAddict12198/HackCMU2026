# Copy to .env (never commit .env). OWNER: integrator.
# xAI Grok: https://console.x.ai  -> API key. Pick GROK_MODEL from https://docs.x.ai/docs/models
# (Sept 2026 docs recommend grok-4.6). Grok features are disabled unless BOTH are set.
XAI_API_KEY=
GROK_MODEL=
# Optional: Grok reasoning effort for Ask + the ingredient mapper. Unset = "low" (~2x faster, same tool
# choices on grok-4.6); "default" = send no setting. grok-4.6 rejects "none". Paste only the value after "=".
GROK_REASONING_EFFORT=

# USDA FoodData Central key (free): https://fdc.nal.usda.gov/api-key-signup  (DEMO_KEY is too rate-limited)
USDA_API_KEY=

# Web app data source: mock (fixtures, no backend needed) or real (FastAPI on API_PORT)
VITE_API_MODE=mock

# Which dishes the engine builds: core (default; demo + sanity) or all (core + extended)
DATA_TIER=core
